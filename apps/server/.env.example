# Porta do servidor NestJS
PORT=3000

# Cloud SQL MySQL — mysql://usuario:senha@host:porta/pilari_academy
# Local (recomendado): Cloud SQL Auth Proxy → host 127.0.0.1
# Produção (Cloud Run): socket unix via instance connection name
DATABASE_URL=mysql://user:password@127.0.0.1:3306/pilari_academy

# Firebase Admin — projeto DEDICADO do EAD (base de usuários isolada do ERP)
# Firebase Console (projeto novo do EAD) > Project Settings > Service Accounts > Generate new private key
# Converter p/ Base64 (PowerShell):
#   [Convert]::ToBase64String([IO.File]::ReadAllBytes("serviceAccount.json"))
# Em ambiente Google Cloud com ADC, pode deixar vazio.
FIREBASE_SERVICE_ACCOUNT_BASE64=

# Trava de segurança: o guard recusa autenticar se isto não for "1".
AUTH_REQUIRED=1

# Web API key do Firebase (a MESMA pública do client, VITE_FIREBASE_API_KEY). Não é segredo —
# vai no bundle do browser. O server usa só para pedir ao Firebase o envio do e-mail de
# redefinição de senha (accounts:sendOobCode) no fluxo admin.
FIREBASE_WEB_API_KEY=

# Asaas — gateway de pagamento. Sandbox em dev.
ASAAS_BASE_URL=https://sandbox.asaas.com/api/v3
ASAAS_API_KEY=
# Token compartilhado com o webhook do Asaas (header asaas-access-token)
ASAAS_WEBHOOK_TOKEN=

# Google Cloud Storage — bucket dos vídeos/anexos das aulas (URLs assinadas)
GCS_BUCKET=

# Segredo p/ assinar os tokens do proxy de PDF das aulas (/api/files/attachments/:id/pdf),
# que serve o PDF pelo domínio do app em vez do link direto do Google (evita bloqueio de
# DevTools corporativo e mantém a mesma origem). Se vazio, usa um segredo aleatório em
# memória — OK com 1 instância; em produção MULTI-INSTÂNCIA (Cloud Run escalando) defina um
# valor fixo, senão um token gerado numa instância não valida na outra. Gere com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PDF_PROXY_SECRET=

# pdfSynth — microserviço que renderiza o PDF do certificado (HTML → Chrome → PDF/A).
# Obrigatório para emitir certificado: não há endereço padrão no código. Em Cloud Run o app
# envia identity token automático (IAM).
PDF_SYNTH_URL=

# Content-Security-Policy: vazio/0 = Report-Only (violações só são logadas via
# /api/csp-report); 1 = enforcing (browser bloqueia). Ligar depois de a policy rodar
# limpa em produção — acompanhe "Violação de CSP" nos logs do Cloud Run.
CSP_ENFORCE=0
